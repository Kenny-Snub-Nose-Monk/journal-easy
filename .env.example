# Local MVP, no GCP account or third-party API key required.
# Replace all passwords before use; URL-encode special characters in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL="postgresql://journal:replace-with-a-random-password@127.0.0.1:5432/journal_easy"
AUTH_SECRET= # openssl rand -hex 32
LOCAL_PASSWORD= # openssl rand -hex 24
OWNER_EMAIL=owner@localhost
# Optional explicit additional sign-in recipients for document sharing. Blank = owner only.
ALLOWED_EMAILS=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=localhost:3000
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads

# Optional local AI: run Ollama, select an installed model from `ollama list`.
# Leave unset to keep writing without AI. Cloud endpoints may charge separately.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Example AI_BASE_URL=http://127.0.0.1:11434/v1

# Optional GitHub OAuth (callback: /api/auth/callback/github).
# OWNER_EMAIL must match the email returned by GitHub; only that owner can sign in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional SMTP; blank means no email provider and no delivery.
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_PASSWORD=
NOTICE_EMAIL_TO=

# Optional collaboration. Blank selects HTTP autosave. NEXT_PUBLIC_* requires rebuild.
NEXT_PUBLIC_COLLABORATE_EDIT_URL=
COLLABORATE_EDIT_HTTP_URL=
COLLABORATE_API_AUTH_KEY=

# Optional GCS (only when STORAGE_DRIVER=gcs).
GCS_BUCKET=
NEXT_PUBLIC_MEDIA_HOSTNAME=
